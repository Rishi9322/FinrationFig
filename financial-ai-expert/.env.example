# Financial AI Expert - Configuration Template
# Copy this file to .env and adjust settings as needed

# Server Configuration
PORT=3001
DASHBOARD_PORT=3000
NODE_ENV=development

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50mb
ALLOWED_EXTENSIONS=json,xlsx,xls,csv,txt,pdf

# API Configuration
API_TIMEOUT=120000
CORS_ORIGIN=*
LOG_LEVEL=info

# Database (optional, for future use)
DB_TYPE=file
DB_PATH=./data

# Authentication (optional, for production)
AUTH_ENABLED=false
JWT_SECRET=your-secret-key-here

# Logging
LOG_FILE=./logs/api.log
LOG_REQUESTS=true

# Performance
MAX_TOKENS=2000
TEMPERATURE=0.7
BATCH_SIZE=5

# Security
HTTPS_ONLY=false
RATE_LIMIT=100/15min
REQUEST_VALIDATION=true

# Models to Support
AVAILABLE_MODELS=qwen2.5:7b,llama3.1:8b,mistral

# Financial Analysis
DEFAULT_ANALYSIS_TYPE=comprehensive
INCLUDE_PROJECTIONS=true
INCLUDE_RISK_ASSESSMENT=true

# File Storage
KEEP_UPLOADED_FILES=false
AUTO_CLEANUP_DAYS=7
