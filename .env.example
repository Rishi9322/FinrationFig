# OpenRouter API Configuration
# Get your API key from https://openrouter.ai
VITE_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_OPENROUTER_MODEL_NAME=google/gemma-4-31b-it:free

# Local AI Server (financial-ai-expert)
# Leave blank for local dev (defaults to http://localhost:3001)
# In production, set to your deployed server URL, e.g. https://your-ai-server.railway.app
VITE_LOCAL_AI_URL=

# Resend Email API
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Analytics / Search Console
VITE_GA_ID=G-XXXXXXXXXX
VITE_GSC_VERIFICATION=

VITE_CLARITY_ID=

# Server-side AI providers (Supabase Edge Function secrets, NOT Vite vars)
# Tried in order: OpenRouter (free) -> NVIDIA (free) -> Vercel AI Gateway (paid)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=google/gemma-4-31b-it:free
NVIDIA_API_KEY=
NVIDIA_MODEL_NAME=meta/llama-3.3-70b-instruct
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5-mini
